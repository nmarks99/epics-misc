record(bi, "$(P)Done")
{
    field(DTYP, "asynInt32")
    field(ONAM, "Done")
    field(ZNAM, "Running")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT=1))DONE")
    field(VAL, 1)
    field(SCAN, "I/O Intr")
    # field(FLNK, "$(P)clear_busy.PROC")
}

